# --- Regenerable multiworld outputs ------------------------------------------
# The 15 worlds' inputs, metrics, and summaries ARE tracked. These four classes
# are bulk derived artifacts (~410 MB) reproduced by:
#   PYTHONHASHSEED=0 python3 scripts/run_multiworld_experiments.py \
#       --output-dir data/evomem_enterprise_v3/worlds --resume --rerun-evaluation
data/evomem_enterprise_v3/worlds/*/phase3/context_packets_*.jsonl
data/evomem_enterprise_v3/worlds/*/phase3/llm_inputs_*.jsonl
data/evomem_enterprise_v3/worlds/*/phase3/llm_proxy_predictions_*.jsonl
data/evomem_enterprise_v3/worlds/*/phase3/per_task_metrics_*.jsonl

